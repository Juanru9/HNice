<Application x:Class="HNice.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:util="clr-namespace:HNice.Util"
             xmlns:local="clr-namespace:HNice">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Palette.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <util:EqualsConverter x:Key="Equals" />
            <util:HasValueToVisibilityConverter x:Key="HasValue" />
            <util:HasValueToVisibilityConverter x:Key="NoValue" Invert="True" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
