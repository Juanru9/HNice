<UserControl x:Class="HNice.View.Tools.CreditsToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Style="{StaticResource Section}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Balance" />
            <TextBox x:Name="Amount" Text="{Binding Credits, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource TextXl}"
                     Foreground="{StaticResource Gold}" MinHeight="46" Width="220" HorizontalAlignment="Left"
                     AutomationProperties.Name="Credit balance" />
        </StackPanel>

        <StackPanel Style="{StaticResource Section}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Presets" />
            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButton}" Content="{Binding}"
                                Command="{Binding DataContext.PresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Button Style="{StaticResource AccentButton}" Content="Set balance" HorizontalAlignment="Left" MinWidth="160"
                Command="{Binding CreditsCommand}" IsDefault="True" />
        <TextBlock Style="{StaticResource Disclosure}"
                   Text="Only the number in your purse changes. You cannot spend credits you do not have." />
    </StackPanel>
</UserControl>
