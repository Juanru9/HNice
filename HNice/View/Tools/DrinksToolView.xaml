<UserControl x:Class="HNice.View.Tools.DrinksToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Style="{StaticResource Section}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Machine" />
            <ListBox ItemsSource="{Binding FurniName}" SelectedValuePath="Value"
                     SelectedValue="{Binding SelectedFurni, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource OptionRow}"
                     AutomationProperties.Name="Drink machine">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource TextXs}" Foreground="{StaticResource TextLo}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Key}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <CheckBox Content="Place it next to me, facing me" IsChecked="{Binding PlaceInFrontOfMe}" Margin="0,0,0,16"
                  ToolTip="Machines only face 2 or 4, so it goes on your west tile, or your north tile when you look north. Keep that tile free. Off = use the position below." />

        <StackPanel Style="{StaticResource Section}">
            <DockPanel Margin="0,0,0,5">
                <TextBlock DockPanel.Dock="Right" FontSize="{StaticResource TextXs}" Foreground="{StaticResource Success}"
                           Text="● following you" Visibility="{Binding IsTracking, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="Position" />
            </DockPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="X" Foreground="{StaticResource TextLo}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Style="{StaticResource NumberInput}" Text="{Binding XCoord}" AutomationProperties.Name="X" />
                <TextBlock Text="Y" Foreground="{StaticResource TextLo}" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Style="{StaticResource NumberInput}" Text="{Binding YCoord}" AutomationProperties.Name="Y" />
            </StackPanel>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Facing" Margin="0,12,0,5" />
            <Border Style="{StaticResource SegmentGroup}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="drinkRot" Content="2" IsChecked="{Binding Rotation, Converter={StaticResource Equals}, ConverterParameter=2}"
                                 ToolTip="Facing 2: use it from its east side" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="drinkRot" Content="4" IsChecked="{Binding Rotation, Converter={StaticResource Equals}, ConverterParameter=4}"
                                 ToolTip="Facing 4: use it from its south side" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Button Style="{StaticResource AccentButton}" Content="Drop machine" HorizontalAlignment="Left" MinWidth="160"
                Command="{Binding DrinkMachineGeneratorCommand}" IsDefault="True" />

        <Expander Header="Other sprite" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBox Style="{StaticResource MonoInput}" Width="180"
                         Text="{Binding CustomFurniName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Custom sprite name" />
                <Button Content="Drop" Margin="8,0,0,0" Command="{Binding CustomDrinkMachineGeneratorCommand}" />
            </StackPanel>
        </Expander>

        <TextBlock Style="{StaticResource Disclosure}"
                   Text="Drawn on your screen only. Click it to get the drink: you see it in your hand, other players do not." />
    </StackPanel>
</UserControl>
