<UserControl x:Class="HNice.View.Tools.ImitateToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Name + motto for the people list. -->
        <DataTemplate x:Key="PersonItem">
            <StackPanel>
                <TextBlock Text="{Binding DisplayName}" />
                <TextBlock Text="{Binding DisplayMotto}" FontSize="{StaticResource TextXs}" Foreground="{StaticResource TextLo}"
                           TextTrimming="CharacterEllipsis" MaxWidth="300"
                           Visibility="{Binding DisplayMotto, Converter={StaticResource HasValue}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- ===== Pick someone ===== -->
        <Border Style="{StaticResource Card}" Background="{StaticResource Surface1}" Padding="14,12" Margin="0,0,0,20">
            <StackPanel>
                <CheckBox Content="Pick by clicking a Habbo in the game" IsChecked="{Binding PickFromGame}" />
                <CheckBox Content="Wear the look right away" IsChecked="{Binding ApplyOnPick}" Margin="0,8,0,0"
                          IsEnabled="{Binding PickFromGame}" />
                <TextBlock Style="{StaticResource Hint}" Text="{Binding PickMessage}" Foreground="{StaticResource Gold}" Margin="0,10,0,12" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="People in the room" />
                <ComboBox ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}"
                          ItemTemplate="{StaticResource PersonItem}" AutomationProperties.Name="People in the room"
                          Visibility="{Binding People.Count, Converter={StaticResource HasValue}}" />
                <TextBlock Style="{StaticResource Hint}" Text="Nobody else here yet. Enter a room with people."
                           Visibility="{Binding People.Count, Converter={StaticResource NoValue}}" />
            </StackPanel>
        </Border>

        <!-- ===== Look ===== -->
        <StackPanel Style="{StaticResource Section}">
            <DockPanel Margin="0,0,0,5">
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Use my avatar" Padding="6,2" MinHeight="0"
                        Command="{Binding UseMyAvatarCommand}" ToolTip="Available once you are logged in" />
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0" Text="Name" VerticalAlignment="Bottom" />
            </DockPanel>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Name" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Figure" Margin="0,12,0,5" />
            <TextBox Style="{StaticResource MonoInput}" Text="{Binding Figure, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="Wrap" AutomationProperties.Name="Figure" />
            <TextBlock Style="{StaticResource FieldLabel}" Text="Motto" Margin="0,12,0,5" />
            <TextBox Text="{Binding Mission}" AutomationProperties.Name="Motto" />
        </StackPanel>

        <StackPanel Style="{StaticResource Section}" Orientation="Horizontal">
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Gender" />
                <Border Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="imitateSex" Content="Male"
                                     IsChecked="{Binding Sex, Converter={StaticResource Equals}, ConverterParameter=M}" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="imitateSex" Content="Female"
                                     IsChecked="{Binding Sex, Converter={StaticResource Equals}, ConverterParameter=F}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Margin="24,0,0,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="User id" />
                <TextBox Style="{StaticResource NumberInput}" Width="100" Text="{Binding UserId}" AutomationProperties.Name="User id"
                         ToolTip="Your own id is used automatically once you are logged in" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource AccentButton}" Content="Apply look" MinWidth="140"
                    Command="{Binding ImitateCommand}" IsDefault="True"
                    ToolTip="Only on your screen" />
            <Button Content="Wear it for real" MinWidth="140" Margin="8,0,0,0"
                    Command="{Binding WearForRealCommand}"
                    ToolTip="Saves this figure through the wardrobe. Needs your own gender and a logged-in session." />
        </StackPanel>
        <TextBlock Style="{StaticResource Disclosure}"
                   Text="Apply look changes only your screen. Wear it for real saves the figure through the wardrobe, so everyone sees it; the server drops items your account cannot wear. Your name, gender and motto stay yours." />
    </StackPanel>
</UserControl>
