<UserControl x:Class="HNice.View.Tools.PostersToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <StackPanel Style="{StaticResource Section}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Poster design" />
            <TextBox Style="{StaticResource NumberInput}" Width="90" HorizontalAlignment="Left"
                     Text="{Binding PosterType}" AutomationProperties.Name="Poster design number" />
        </StackPanel>

        <StackPanel Style="{StaticResource Section}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Wall" />
            <Border Style="{StaticResource SegmentGroup}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="wallSide" Content="Left wall"
                                 IsChecked="{Binding Direction, Converter={StaticResource Equals}, ConverterParameter=l}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="wallSide" Content="Right wall"
                                 IsChecked="{Binding Direction, Converter={StaticResource Equals}, ConverterParameter=r}" />
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Wall tile" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource NumberInput}" Text="{Binding WallX}" AutomationProperties.Name="Wall tile X" />
                        <TextBlock Text="," Foreground="{StaticResource TextLo}" VerticalAlignment="Center" Margin="5,0" />
                        <TextBox Style="{StaticResource NumberInput}" Text="{Binding WallY}" AutomationProperties.Name="Wall tile Y" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Offset (px)" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Style="{StaticResource NumberInput}" Text="{Binding OffsetX}" AutomationProperties.Name="Offset X" />
                        <TextBlock Text="," Foreground="{StaticResource TextLo}" VerticalAlignment="Center" Margin="5,0" />
                        <TextBox Style="{StaticResource NumberInput}" Text="{Binding OffsetY}" AutomationProperties.Name="Offset Y" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Button Style="{StaticResource AccentButton}" Content="Hang poster" HorizontalAlignment="Left" MinWidth="160"
                Command="{Binding AddPosterCommand}" IsDefault="True" />

        <Expander Header="Advanced" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Item id" VerticalAlignment="Center" Margin="0,0,12,6" />
                <TextBox Grid.Column="1" Style="{StaticResource MonoInput}" Text="{Binding PosterId}" Margin="0,0,0,6" />
                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Sprite" VerticalAlignment="Center" Margin="0,0,12,6" />
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoInput}" Text="{Binding Sprite}" Margin="0,0,0,6" />
                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Owner" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Owner}" ToolTip="Empty uses your own name" />
            </Grid>
        </Expander>

        <TextBlock Style="{StaticResource Disclosure}"
                   Text="Drawn on your screen only. Reusing a real item id moves that poster instead of adding a new one." />
    </StackPanel>
</UserControl>
