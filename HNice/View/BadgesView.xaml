<Window x:Class="HNice.View.BadgesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        ResizeMode="NoResize"
        Title="Badges (client-side)" Height="170" Width="320">
    <StackPanel Margin="10">
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                   Text="Shows badges in your own badge list only."/>
        <StackPanel Orientation="Horizontal">
            <Label Content="Badge code:"/>
            <TextBox Width="120" VerticalAlignment="Center" Text="{Binding BadgeCode}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Width="120" Height="28" Content="Add badge" Command="{Binding AddBadgeCommand}"/>
            <Button Width="120" Height="28" Margin="10,0,0,0" Content="Add all (preset)" Command="{Binding AddAllBadgesCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
