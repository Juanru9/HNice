<Window x:Class="HNice.View.ModFunctionsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        ResizeMode="NoResize"
        Title="MOD functions (client-side)" Height="220" Width="360">
    <StackPanel Margin="10">
        <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                   Text="Fake staff messages shown on your own client only."/>
        <Label Content="Hotel broadcast:"/>
        <TextBox Text="{Binding Broadcast}" Margin="0,0,0,4"/>
        <Button HorizontalAlignment="Left" Width="150" Content="Send broadcast" Command="{Binding SendBroadcastCommand}"/>
        <Label Content="Mod warning:" Margin="0,8,0,0"/>
        <TextBox Text="{Binding ModWarning}" Margin="0,0,0,4"/>
        <Button HorizontalAlignment="Left" Width="150" Content="Send mod warning" Command="{Binding SendModWarningCommand}"/>
    </StackPanel>
</Window>
